{"stories":[
{"id":"ark","seq":1,"on":true,"title":"Noah's Big Boat","cover":[{"p":"sky"},{"p":"rainbow","x":50,"y":34,"s":0.9},{"p":"sea"},{"p":"ark","x":50,"y":82,"s":0.62},{"p":"giraffe","x":74,"y":69,"s":0.3},{"p":"lion","x":27,"y":69,"s":0.3,"f":1}],
 "pages":[{"text":"God asked Noah to build a great big boat.","clip":"s-ark-1","art":[{"p":"sky"},{"p":"light","x":22,"y":18,"s":1.1},{"p":"hills"},{"p":"tree","x":84,"y":80,"s":0.7},{"p":"noah","x":56,"y":92,"s":0.72,"o":"up"}]},{"text":"Noah worked hard. Tap, tap, tap went his hammer!","clip":"s-ark-2","art":[{"p":"sky"},{"p":"sun","x":84,"y":16,"s":0.35},{"p":"hills"},{"p":"ark","x":38,"y":84,"s":0.6},{"p":"noah","x":78,"y":94,"s":0.62,"o":"hammer"}]},{"text":"The animals came two by two. Moo! Baa! Roar!","clip":"s-ark-3","art":[{"p":"sky"},{"p":"hills"},{"p":"ark","x":24,"y":74,"s":0.5},{"p":"sheep","x":64,"y":79,"s":0.42,"f":1},{"p":"sheep","x":78,"y":80,"s":0.42,"f":1},{"p":"giraffe","x":91,"y":90,"s":0.46,"f":1},{"p":"cow","x":13,"y":89,"s":0.44,"f":1},{"p":"cow","x":28,"y":90,"s":0.44,"f":1},{"p":"lion","x":50,"y":96,"s":0.5,"f":1},{"p":"lion","x":65,"y":97,"s":0.5,"f":1},{"p":"giraffe","x":82,"y":99,"s":0.52,"f":1}]},{"text":"Then the rain came down. Pitter, patter, pitter, patter.","clip":"s-ark-4","art":[{"p":"grey"},{"p":"rain","x":30,"y":18,"s":0.9},{"p":"rain","x":72,"y":22,"s":0.9},{"p":"sea"},{"p":"ark","x":50,"y":84,"s":0.62}]},{"text":"Inside the boat, Noah and the animals stayed safe and cozy.","clip":"s-ark-5","art":[{"p":"inside"},{"p":"noah","x":30,"y":94,"s":0.62},{"p":"sheep","x":54,"y":92,"s":0.5},{"p":"lion","x":76,"y":94,"s":0.5,"f":1},{"p":"giraffe","x":88,"y":92,"s":0.42,"f":1}]},{"text":"The sun came out, and God put a rainbow in the sky!","clip":"s-ark-6","art":[{"p":"sky"},{"p":"sun","x":18,"y":16,"s":0.4},{"p":"rainbow","x":56,"y":32,"s":0.95},{"p":"hills"},{"p":"ark","x":30,"y":84,"s":0.5},{"p":"dove","x":70,"y":52,"s":0.6},{"p":"noah","x":74,"y":96,"s":0.6,"o":"up"}]},{"text":"God made a promise to Noah: never again would rain cover the whole earth. Whenever we see a rainbow, we remember that God keeps his promises, and God loves us and takes care of us.","clip":"s-ark-7","textAfter":true,"color":{"part":"rainbow6","bands":["red","orange","yellow","green","blue","purple"]},"art":[{"p":"sky"},{"p":"light","x":20,"y":16,"s":0.9},{"p":"hills"},{"p":"rainbow6","x":50,"y":34,"s":1},{"p":"ark","x":50,"y":84,"s":0.5},{"p":"dove","x":78,"y":52,"s":0.5}]}],
 "question":{"text":"Who came on the boat?","clip":"s-ark-q","choices":["sheep","lion","giraffe"],"answer":"any","yes":"s-ark-yes","yesText":"Yes! They came on the boat!"}},
{"id":"creation","seq":2,"on":false,"title":"God Made Everything","cover":[{"p":"sky"},{"p":"sun","x":22,"y":18,"s":0.4},{"p":"sea"},{"p":"tree","x":72,"y":80,"s":0.8},{"p":"fish","x":30,"y":88,"s":0.6},{"p":"bird","x":56,"y":30,"s":0.7}],
 "pages":[{"text":"In the very beginning, God made the light. Hello, light!","clip":"s-creation-1","art":[{"p":"night"},{"p":"light","x":50,"y":40,"s":1.4}]},{"text":"God made the big blue sky and the deep sea.","clip":"s-creation-2","art":[{"p":"sky"},{"p":"cloud","x":30,"y":22,"s":0.6},{"p":"cloud","x":74,"y":30,"s":0.5},{"p":"sea"},{"p":"fish","x":50,"y":90,"s":0.6}]},{"text":"God made trees and flowers, and yummy fruit to eat.","clip":"s-creation-3","art":[{"p":"sky"},{"p":"hills"},{"p":"tree","x":30,"y":82,"s":0.9},{"p":"tree","x":72,"y":80,"s":0.7},{"p":"flower","x":50,"y":92,"s":0.6},{"p":"flower","x":86,"y":92,"s":0.6}]},{"text":"God made the sun, the moon, and lots of twinkly stars.","clip":"s-creation-4","art":[{"p":"night"},{"p":"sun","x":24,"y":22,"s":0.4},{"p":"moon","x":74,"y":26,"s":0.4},{"p":"stars","x":52,"y":54}]},{"text":"God made fish, birds, and every animal. Hop, swim, fly!","clip":"s-creation-5","art":[{"p":"sky"},{"p":"sea"},{"p":"bird","x":30,"y":26,"s":0.7},{"p":"fish","x":22,"y":90,"s":0.5},{"p":"sheep","x":58,"y":74,"s":0.45},{"p":"lion","x":84,"y":76,"s":0.45,"f":1}]},{"text":"God made people too. God made it all, and it's good!","clip":"s-creation-6","art":[{"p":"sky"},{"p":"hills"},{"p":"man","x":40,"y":92,"s":0.6},{"p":"woman","x":60,"y":92,"s":0.6},{"p":"sheep","x":82,"y":90,"s":0.4,"f":1},{"p":"heart","x":50,"y":22,"s":0.6}]}],
 "question":{"text":"What did God make?","clip":"s-creation-q","choices":["sun","fish","tree"],"answer":"any","yes":"s-creation-yes","yesText":"Yes! God made that!"}},
{"id":"nativity","seq":3,"on":false,"title":"Baby Jesus Is Born","cover":[{"p":"night"},{"p":"star","x":50,"y":14,"s":0.8},{"p":"hills"},{"p":"stable","x":50,"y":84,"s":0.9},{"p":"baby","x":50,"y":82,"s":0.6}],
 "pages":[{"text":"An angel told Mary, \"You will have a very special baby.\"","clip":"s-nativity-1","art":[{"p":"sky"},{"p":"light","x":30,"y":24},{"p":"hills"},{"p":"angel","x":34,"y":82,"s":0.6},{"p":"mary","x":70,"y":92,"s":0.62}]},{"text":"Mary and Joseph went on a long trip with their donkey.","clip":"s-nativity-2","art":[{"p":"sky"},{"p":"hills"},{"p":"joseph","x":30,"y":92,"s":0.6},{"p":"mary","x":52,"y":92,"s":0.6},{"p":"donkey","x":78,"y":92,"s":0.6}]},{"text":"Every room was full, so they rested in a cozy stable.","clip":"s-nativity-3","art":[{"p":"night"},{"p":"stars","x":50,"y":18},{"p":"hills"},{"p":"stable","x":50,"y":86,"s":0.85},{"p":"mary","x":44,"y":84,"s":0.42},{"p":"joseph","x":58,"y":84,"s":0.42}]},{"text":"Baby Jesus was born! Mary wrapped him up warm and snug.","clip":"s-nativity-4","art":[{"p":"night"},{"p":"star","x":50,"y":12,"s":0.6},{"p":"stable","x":50,"y":90,"s":1.1},{"p":"mary","x":34,"y":88,"s":0.48},{"p":"baby","x":52,"y":88,"s":0.6},{"p":"joseph","x":70,"y":88,"s":0.48}]},{"text":"Angels sang to the shepherds in the fields. \"Good news!\"","clip":"s-nativity-5","art":[{"p":"night"},{"p":"stars","x":30,"y":16},{"p":"angel","x":66,"y":52,"s":0.5},{"p":"hills"},{"p":"shepherd","x":30,"y":94,"s":0.6},{"p":"sheep","x":60,"y":92,"s":0.4},{"p":"sheep","x":78,"y":90,"s":0.4,"f":1}]},{"text":"The shepherds came to see baby Jesus, God's Son.","clip":"s-nativity-6","art":[{"p":"night"},{"p":"star","x":50,"y":12,"s":0.6},{"p":"stable","x":50,"y":90,"s":1.1},{"p":"mary","x":30,"y":88,"s":0.48},{"p":"baby","x":50,"y":88,"s":0.6},{"p":"shepherd","x":72,"y":92,"s":0.5,"f":1},{"p":"sheep","x":88,"y":94,"s":0.36,"f":1}]}],
 "question":{"text":"Who came to see baby Jesus?","clip":"s-nativity-q","choices":["shepherd","sheep","angel"],"answer":"any","yes":"s-nativity-yes","yesText":"Yes! They came to see Jesus!"}},
{"id":"storm","seq":4,"on":false,"title":"Jesus Calms the Storm","cover":[{"p":"sky"},{"p":"sun","x":80,"y":16,"s":0.35},{"p":"sea"},{"p":"sail","x":50,"y":84,"s":1.3},{"p":"jesus","x":44,"y":78,"s":0.45},{"p":"man","x":60,"y":78,"s":0.45},{"p":"hull","x":50,"y":84,"s":1.3}],
 "pages":[{"text":"Jesus and his friends got in a boat to cross the lake.","clip":"s-storm-1","art":[{"p":"sky"},{"p":"sun","x":80,"y":16,"s":0.35},{"p":"sea"},{"p":"sail","x":48,"y":84,"s":1.3},{"p":"jesus","x":40,"y":78,"s":0.45},{"p":"man","x":56,"y":78,"s":0.45},{"p":"hull","x":48,"y":84,"s":1.3}]},{"text":"Jesus was tired, so he took a nap.","clip":"s-storm-2","art":[{"p":"sky"},{"p":"sea"},{"p":"sail","x":50,"y":84,"s":1.3},{"p":"jesus","x":50,"y":80,"s":0.45,"o":"rest"},{"p":"hull","x":50,"y":84,"s":1.3}]},{"text":"Whoosh! The wind blew, and the waves went up and down.","clip":"s-storm-3","art":[{"p":"grey"},{"p":"cloud","x":26,"y":20,"s":0.6},{"p":"cloud","x":70,"y":16,"s":0.6},{"p":"waves"},{"p":"sail","x":50,"y":80,"s":1.3},{"p":"hull","x":50,"y":80,"s":1.3}]},{"text":"His friends were worried. \"Jesus, wake up! Please help!\"","clip":"s-storm-4","art":[{"p":"grey"},{"p":"waves"},{"p":"sail","x":48,"y":80,"s":1.3},{"p":"man","x":38,"y":74,"s":0.45,"o":"up"},{"p":"man","x":58,"y":74,"s":0.45,"o":"up"},{"p":"hull","x":48,"y":80,"s":1.3}]},{"text":"Jesus said, \"Wind, hush. Waves, be calm.\" And they were!","clip":"s-storm-5","art":[{"p":"grey"},{"p":"sea"},{"p":"sail","x":50,"y":84,"s":1.3},{"p":"jesus","x":46,"y":78,"s":0.5,"o":"up"},{"p":"hull","x":50,"y":84,"s":1.3}]},{"text":"The sun came out. Jesus always takes care of us.","clip":"s-storm-6","art":[{"p":"sky"},{"p":"sun","x":22,"y":18,"s":0.45},{"p":"sea"},{"p":"sail","x":52,"y":84,"s":1.3},{"p":"jesus","x":46,"y":78,"s":0.45,"o":"out"},{"p":"man","x":60,"y":78,"s":0.45},{"p":"hull","x":52,"y":84,"s":1.3}]}],
 "question":{"text":"Who helped his friends?","clip":"s-storm-q","choices":["jesus","fish","boat"],"answer":"jesus","yes":"s-storm-yes","yesText":"Yes! Jesus helped them!"}},
{"id":"sheep","seq":5,"on":false,"title":"The Lost Sheep","cover":[{"p":"sky"},{"p":"hills"},{"p":"shepherd","x":40,"y":92,"s":0.6},{"p":"sheep","x":68,"y":90,"s":0.5,"f":1}],
 "pages":[{"text":"A kind shepherd had lots and lots of sheep.","clip":"s-sheep-1","art":[{"p":"sky"},{"p":"hills"},{"p":"shepherd","x":24,"y":92,"s":0.6},{"p":"sheep","x":50,"y":84,"s":0.4},{"p":"sheep","x":68,"y":88,"s":0.4,"f":1},{"p":"sheep","x":84,"y":82,"s":0.4},{"p":"sheep","x":60,"y":96,"s":0.4}]},{"text":"One little sheep wandered away. Where did it go?","clip":"s-sheep-2","art":[{"p":"sky"},{"p":"hills"},{"p":"rock","x":30,"y":84,"s":0.8},{"p":"sheep","x":76,"y":80,"s":0.45}]},{"text":"The shepherd looked high and low, over hills and rocks.","clip":"s-sheep-3","art":[{"p":"sky"},{"p":"hills"},{"p":"rock","x":70,"y":84},{"p":"rock","x":86,"y":88,"s":0.7},{"p":"shepherd","x":34,"y":94,"s":0.62}]},{"text":"Baa! There it is! The shepherd found the little sheep.","clip":"s-sheep-4","art":[{"p":"sky"},{"p":"hills"},{"p":"rock","x":80,"y":86,"s":0.8},{"p":"shepherd","x":34,"y":94,"s":0.62,"o":"out"},{"p":"sheep","x":66,"y":90,"s":0.5,"f":1}]},{"text":"He carried it home on his shoulders. Hooray!","clip":"s-sheep-5","art":[{"p":"sky"},{"p":"hills"},{"p":"sheep","x":51,"y":64,"s":0.5},{"p":"shepherd","x":50,"y":94,"s":0.7,"o":"carry"}]},{"text":"Jesus is like that shepherd. He always comes to find us.","clip":"s-sheep-6","art":[{"p":"sky"},{"p":"heart","x":50,"y":20,"s":0.5},{"p":"hills"},{"p":"jesus","x":40,"y":94,"s":0.66,"o":"out"},{"p":"sheep","x":70,"y":92,"s":0.5,"f":1}]}],
 "question":{"text":"Who found the little sheep?","clip":"s-sheep-q","choices":["shepherd","cow","duck"],"answer":"shepherd","yes":"s-sheep-yes","yesText":"Yes! The shepherd found it!"}},
{"id":"children","seq":6,"on":false,"title":"Jesus Loves the Children","cover":[{"p":"sky"},{"p":"hills"},{"p":"jesus","x":50,"y":92,"s":0.66,"o":"out"},{"p":"girl","x":28,"y":92,"s":0.66},{"p":"boy","x":72,"y":92,"s":0.66}],
 "pages":[{"text":"Lots of children wanted to see Jesus.","clip":"s-children-1","art":[{"p":"sky"},{"p":"hills"},{"p":"jesus","x":74,"y":90,"s":0.6},{"p":"girl","x":22,"y":94,"s":0.6},{"p":"boy","x":40,"y":94,"s":0.6}]},{"text":"Some grown-ups said, \"Shh, Jesus is too busy.\"","clip":"s-children-2","art":[{"p":"sky"},{"p":"hills"},{"p":"man","x":30,"y":92,"s":0.6},{"p":"woman","x":50,"y":92,"s":0.6},{"p":"jesus","x":78,"y":90,"s":0.56}]},{"text":"But Jesus smiled and said, \"Come here, children! Come close!\"","clip":"s-children-3","art":[{"p":"sky"},{"p":"hills"},{"p":"jesus","x":50,"y":92,"s":0.66,"o":"out"},{"p":"girl","x":24,"y":94,"s":0.6},{"p":"boy","x":78,"y":94,"s":0.6}]},{"text":"The children ran to Jesus, and he gave them big hugs.","clip":"s-children-4","art":[{"p":"sky"},{"p":"heart","x":50,"y":18,"s":0.5},{"p":"hills"},{"p":"jesus","x":50,"y":92,"s":0.66,"o":"out"},{"p":"girl","x":38,"y":94,"s":0.6},{"p":"boy","x":62,"y":94,"s":0.6}]},{"text":"Jesus put his hands on them and blessed them.","clip":"s-children-5","art":[{"p":"sky"},{"p":"light","x":50,"y":22,"s":0.9},{"p":"hills"},{"p":"jesus","x":50,"y":92,"s":0.66,"o":"out"},{"p":"girl","x":32,"y":94,"s":0.6,"o":"down"},{"p":"boy","x":68,"y":94,"s":0.6,"o":"down"}]},{"text":"Jesus loves every child. Jesus loves you!","clip":"s-children-6","art":[{"p":"sky"},{"p":"heart","x":30,"y":22,"s":0.5},{"p":"heart","x":72,"y":18,"s":0.4},{"p":"hills"},{"p":"jesus","x":44,"y":92,"s":0.66,"o":"out"},{"p":"girl","x":70,"y":94,"s":0.62}]}],
 "question":{"text":"Who does Jesus love?","clip":"s-children-q","choices":["girl","boy","baby"],"answer":"any","yes":"s-children-yes","yesText":"Yes! Jesus loves them, and Jesus loves you!"}}]}
